@using PaydayPerx.Walgreens.Web.Models.Walgreens
@model PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensVaccinationInterestViewModel
@using System
@using System.IO
@using System.Linq
@using Newtonsoft.Json
@{
    ViewBag.Title = "Vaccination Interest";
    ViewBag.HasAgentVersionFooter = true;
    Func<string, string> checkedVaccination = value => Model.Vaccinations != null && Model.Vaccinations.Contains(value) ? "checked" : null;
    var isOtherVaccinationSelected = Model.Vaccinations != null && Model.Vaccinations.Contains("Other");
    var otherVaccinationHidden = isOtherVaccinationSelected ? null : "hidden";
    Func<string, string> checkedPayment = value => Model.PaymentTypes != null && Model.PaymentTypes.Contains(value) ? "checked" : null;
    Func<string, string> checkedProgram = value => string.Equals(Model.Program, value, StringComparison.Ordinal) ? "checked" : null;
    Func<bool, string> checkedMultipleStates = value => Model.MultipleStates.HasValue && Model.MultipleStates.Value == value ? "checked" : null;
    Func<bool, string> checkedPreviousClinic = value => Model.PreviousWalgreensClinic.HasValue && Model.PreviousWalgreensClinic.Value == value ? "checked" : null;
    Func<string, string> formatPhone = value =>
    {
        var digits = new string((value ?? string.Empty).Where(char.IsDigit).Take(11).ToArray());
        if (digits.Length == 11 && digits[0] == '1')
            digits = digits.Substring(1);
        if (digits.Length == 10)
            return "(" + digits.Substring(0, 3) + ") " + digits.Substring(3, 3) + "-" + digits.Substring(6, 4);

        return string.IsNullOrWhiteSpace(value) ? string.Empty : value;
    };
    var reworkPhoneDigits = new string((Model.ReworkPhoneNumber ?? string.Empty).Where(char.IsDigit).Take(11).ToArray());
    var formattedDnis = formatPhone(Model.Dnis);
    var hasDnis = !string.IsNullOrWhiteSpace(Model.Dnis);
    var hasCallId = !string.IsNullOrWhiteSpace(Model.CallId);
    var hasAgentId = !string.IsNullOrWhiteSpace(Model.AgentId);
    var hasBpSessionId = !string.IsNullOrWhiteSpace(Model.BpSessionId);
    var hasGlobalId = !string.IsNullOrWhiteSpace(Model.GlobalId);
    var hasBpOrigin = !string.IsNullOrWhiteSpace(Model.BpOrigin);
    var isReadOnly = ViewBag.IsReadOnly == true;
    var isSupervisorClinicSubmission = Model.SupervisorEntryId.GetValueOrDefault() > 0
        && string.Equals(Model.SupervisorEntryType, PaydayPerx.Walgreens.Web.Models.Admin.WalgreensSubmissionEditViewModel.ClinicSubmissionType, StringComparison.OrdinalIgnoreCase);
    var isSupervisorSendInfo = Model.SupervisorEntryId.GetValueOrDefault() > 0
        && string.Equals(Model.SupervisorEntryType, PaydayPerx.Walgreens.Web.Models.Admin.WalgreensSubmissionEditViewModel.SendInfoType, StringComparison.OrdinalIgnoreCase);
    var isSupervisorSendVoucher = Model.SupervisorEntryId.GetValueOrDefault() > 0
        && string.Equals(Model.SupervisorEntryType, PaydayPerx.Walgreens.Web.Models.Admin.WalgreensSubmissionEditViewModel.SendVoucherType, StringComparison.OrdinalIgnoreCase);
    var isSupervisorCorrectableEntry = isSupervisorClinicSubmission || isSupervisorSendInfo || isSupervisorSendVoucher;
    var isInvalidated = string.Equals(Model.SupervisorEntryStatus, "Invalidated", StringComparison.OrdinalIgnoreCase);
    var lastInvalidationCancellation = ViewBag.LastInvalidationCancellation as PaydayPerx.Walgreens.Web.Models.Admin.WalgreensInvalidationCancellationAudit;
    var correctionEntryLabel = isSupervisorSendVoucher
        ? "Send Voucher entry"
        : isSupervisorSendInfo
            ? "GK Send Info entry"
            : "clinic submission";
    var hasEquivalentSendInfo = isSupervisorClinicSubmission && Model.SupervisorEquivalentSendInfoId.HasValue;
    var equivalentRequestLabel = string.Equals(
        Model.SupervisorEquivalentRequestType,
        PaydayPerx.Walgreens.Web.Models.Admin.WalgreensSubmissionEditViewModel.SendVoucherType,
        StringComparison.OrdinalIgnoreCase)
        ? "Send Voucher"
        : "GK Send Info";
    var equivalentSendInfoIsInvalidated = string.Equals(
        Model.SupervisorEquivalentSendInfoStatus,
        "Invalidated",
        StringComparison.OrdinalIgnoreCase);
    var correctionDispositionOptions = ViewBag.CorrectionDispositionOptions as System.Collections.Generic.IEnumerable<string>
        ?? Enumerable.Empty<string>();
    var reworkDispositionOptions = ViewBag.ReworkDispositionOptions as System.Collections.Generic.IEnumerable<string>
        ?? Enumerable.Empty<string>();
    var sendInfoReworkDispositionOptions = ViewBag.SendInfoReworkDispositionOptions as System.Collections.Generic.IEnumerable<string>
        ?? Enumerable.Empty<string>();
    var isSendInfoRework = Model.SendInfoWorkItemId.GetValueOrDefault() > 0;
    var isQueueWork = Model.ReworkItemId.GetValueOrDefault() > 0 || isSendInfoRework;
    var queueDispositionOptions = isSendInfoRework ? sendInfoReworkDispositionOptions : reworkDispositionOptions;
    var supportsDraftSave = string.IsNullOrWhiteSpace(Model.SupervisorEntryType)
        || string.Equals(Model.SupervisorEntryType, PaydayPerx.Walgreens.Web.Models.Admin.WalgreensSubmissionEditViewModel.ClinicSubmissionType, StringComparison.OrdinalIgnoreCase);
    var hasLeadContext = Model.PaydayPerxLeadId.HasValue
        || !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadListName)
        || !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadWebAddress)
        || !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadSicDescription)
        || !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadEmployeeCount);
    var callScriptPath = Server.MapPath("~/Scripts/walgreens-call-script.js");
    var callScriptVersion = File.Exists(callScriptPath) ? File.GetLastWriteTimeUtc(callScriptPath).Ticks.ToString() : "1";
    var additionalLocationsJson = JsonConvert.SerializeObject(Model.AdditionalLocations ?? new System.Collections.Generic.List<PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensLocationViewModel>());
    Func<string, string> normalizePhone = value =>
    {
        var digits = new string((value ?? string.Empty).Where(char.IsDigit).ToArray());
        return digits.Length == 11 && digits[0] == '1' ? digits.Substring(1) : digits;
    };
    var importedPhoneOptions = new System.Collections.Generic.List<Tuple<
        PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensImportedContact,
        PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensImportedContactPhone>>();
    var displayedPhoneNumbers = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var mainPhoneDigits = normalizePhone(Model.PhoneNumber);
    if (!string.IsNullOrWhiteSpace(mainPhoneDigits))
    {
        displayedPhoneNumbers.Add(mainPhoneDigits);
    }
    foreach (var importedContact in Model.ImportedContacts ?? new System.Collections.Generic.List<PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensImportedContact>())
    {
        foreach (var importedPhone in importedContact.Phones ?? new System.Collections.Generic.List<PaydayPerx.Walgreens.Web.Models.Walgreens.WalgreensImportedContactPhone>())
        {
            var importedDigits = normalizePhone(importedPhone.NormalizedPhone ?? importedPhone.PhoneNumber);
            if (importedPhoneOptions.Count < 2
                && importedDigits.Length >= 7
                && displayedPhoneNumbers.Add(importedDigits))
            {
                importedPhoneOptions.Add(Tuple.Create(importedContact, importedPhone));
            }
        }
    }
}
<div class="agent-theme-toolbar" aria-label="Page actions and display settings">
    @if (isSupervisorCorrectableEntry && !isInvalidated && !isReadOnly)
    {
        <button type="button"
                class="agent-correction-toggle"
                data-agent-correction-toggle
                aria-expanded="false"
                aria-controls="agentCorrectionPanel">
            &#9940; Invalidate
        </button>
    }
    <label class="theme-selector">
        <span>Theme</span>
        <select id="walgreensThemeSelector" aria-label="Color theme">
            <option value="dark">&#127753; - Dark</option>
            <option value="light">&#127751; - Light</option>
            <option value="system" selected="selected">&#128421;&#65039; - System</option>
        </select>
    </label>
</div>

@if (Model.WasSavedOnly)
{
    <div class="agent-success" role="status">
        Intake record @Model.SavedRecordId was saved in the portal. Nothing was sent to Walgreens.
    </div>
}

<div class="agent-toast" data-agent-toast role="status" aria-live="polite" aria-atomic="true"></div>

@if (isQueueWork && !isSupervisorCorrectableEntry)
{
    <section class="agent-rework-banner" aria-label="Rework call company and phone number">
        <div>
            <span>@(isSendInfoRework ? "GK Send Info follow-up" : "Rework item") #@(isSendInfoRework ? Model.SendInfoWorkItemId : Model.ReworkItemId)</span>
            <div class="agent-rework-identity">
                <h2>@(!string.IsNullOrWhiteSpace(Model.Company) ? Model.Company : "Company unavailable")</h2>
                <strong data-rework-phone data-rework-phone-copy="@reworkPhoneDigits">@formatPhone(Model.ReworkPhoneNumber)</strong>
            </div>
        </div>
        <div class="agent-rework-control-stack">
            <div class="agent-rework-control-card agent-rework-disposition-card">
                <form action="@(isSendInfoRework ? Url.Action("Disposition", "SendInfoRework") : Url.Action("ReworkDisposition", "Home"))" method="post" data-rework-disposition-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ItemId" value="@(isSendInfoRework ? Model.SendInfoWorkItemId : Model.ReworkItemId)" />
                    <input type="hidden" name="LeadId" value="@Model.PaydayPerxLeadId" />
                    <label>
                        <span>Disposition</span>
                        <select name="Disposition" required>
                            <option value="">Choose a disposition</option>
                            @foreach (var disposition in queueDispositionOptions)
                            {
                                <option value="@disposition">@WalgreensOutcomeDisplay.Name(disposition)</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="small-button primary-button">&#128190; @(isSendInfoRework ? "Save disposition" : "Save & complete")</button>
                </form>
            </div>
            <div class="agent-rework-control-card agent-rework-navigation-card" aria-label="Rework item actions">
                <button type="button" class="small-button" data-copy-rework-phone>&#128203; Copy phone</button>
                <a href="@(isSendInfoRework ? Url.Action("Index", "SendInfoRework") : Url.Action("Index", "ReworkUnworkables"))" class="small-button">&#8617;&#65039; Back to List</a>
                @using (Html.BeginForm("Next", isSendInfoRework ? "SendInfoRework" : "ReworkUnworkables", FormMethod.Post, new { @class = "agent-rework-next-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="currentItemId" value="@(isSendInfoRework ? Model.SendInfoWorkItemId : Model.ReworkItemId)" />
                    <input type="hidden" name="redirectToAgent" value="true" />
                    <button type="submit" class="small-button primary-button">Next Item</button>
                }
            </div>
        </div>
    </section>
    <style>
        .agent-rework-banner { align-items: center; background: var(--warning-panel-bg); border: 2px solid var(--warning-text); border-radius: .75rem; color: var(--text); display: flex; gap: 1rem; justify-content: space-between; margin: 1rem auto; max-width: 96rem; padding: 1rem 1.25rem; }
        .agent-rework-banner span { color: var(--muted); display: block; font-size: .85rem; font-weight: 600; }
        .agent-rework-identity { align-items: baseline; display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; margin-top: .35rem; }
        .agent-rework-banner h2 { font-size: clamp(1.15rem, 3vw, 1.65rem); font-weight: 700; line-height: 1.2; margin: 0; }
        .agent-rework-banner strong { display: block; font-size: clamp(1.55rem, 4vw, 2.4rem); letter-spacing: .04em; }
        .agent-rework-control-stack { display: grid; gap: .65rem; min-width: min(100%, 42rem); }
        .agent-rework-control-card { align-items: center; background: var(--surface-raised); border: 1px solid var(--line); border-radius: .6rem; display: flex; flex-wrap: wrap; gap: .65rem; padding: .75rem; }
        .agent-rework-disposition-card form { align-items: flex-end; display: flex; flex: 1 1 auto; flex-wrap: wrap; gap: .65rem; margin: 0; }
        .agent-rework-disposition-card form label { display: grid; flex: 1 1 13rem; gap: .25rem; }
        .agent-rework-disposition-card form label span { font-size: .78rem; font-weight: 600; }
        .agent-rework-disposition-card form select { min-width: 13rem; width: 100%; }
        .agent-rework-navigation-card .small-button, .agent-rework-disposition-card .small-button { align-items: center; display: inline-flex; justify-content: center; text-decoration: none; }
        .agent-rework-next-form { margin: 0; }
        @@media (max-width: 760px) { .agent-rework-banner { align-items: stretch; flex-direction: column; } .agent-rework-control-stack { min-width: 0; } }
    </style>
}

@if (isReadOnly)
{
    <div class="agent-success" role="status">
        Read-only record view. No changes can be saved or sent from this page.
    </div>
}

@if (hasEquivalentSendInfo)
{
    <div class="agent-correction-related" role="status">
        Matching @equivalentRequestLabel entry <strong>#@Model.SupervisorEquivalentSendInfoId</strong>
        has status <strong>@Model.SupervisorEquivalentSendInfoStatus</strong>.
        @if (equivalentSendInfoIsInvalidated)
        {
            <text>It has already been invalidated.</text>
        }
        else
        {
            <text>You can invalidate both entries together when confirming this correction.</text>
        }
    </div>
}

@if (isSupervisorCorrectableEntry && lastInvalidationCancellation != null)
{
    <section class="agent-correction-panel" aria-labelledby="cancellationAuditHeading">
        <h2 id="cancellationAuditHeading">Last invalidation cancellation</h2>
        <dl>
            <div><dt>Cancelled by</dt><dd>@lastInvalidationCancellation.CancelledBy</dd></div>
            <div><dt>Cancelled</dt><dd>@lastInvalidationCancellation.CancelledAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd></div>
            <div><dt>Reason</dt><dd>@lastInvalidationCancellation.CancellationReason</dd></div>
        </dl>
    </section>
}
@if (isSupervisorCorrectableEntry && isInvalidated)
{
    <section class="agent-correction-panel" aria-labelledby="correctionHeading">
        <h2 id="correctionHeading">Invalidated @correctionEntryLabel</h2>
        <p>This historical entry is excluded from Walgreens reports and cannot be saved or resubmitted.</p>
        <dl>
            <div><dt>Corrected disposition</dt><dd>@WalgreensOutcomeDisplay.Name(Model.SupervisorCorrectedDisposition)</dd></div>
            <div><dt>Reason</dt><dd>@Model.SupervisorCorrectionReason</dd></div>
            <div><dt>Corrected by</dt><dd>@Model.SupervisorCorrectedBy</dd></div>
            <div><dt>Corrected</dt><dd>@(Model.SupervisorCorrectedAtUtc.HasValue ? Model.SupervisorCorrectedAtUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : string.Empty)</dd></div>
        </dl>
        @if (ViewBag.CanCancelInvalidation == true)
        {
            <div class="agent-invalidation-cancellation">
            @using (Html.BeginForm("CancelInvalidation", "WalgreensSubmissions", FormMethod.Post, new { @class = "agent-correction-form agent-invalidation-cancellation-form" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="EntryType" value="@Model.SupervisorEntryType" />
                <input type="hidden" name="Id" value="@Model.SupervisorEntryId" />
                <input type="hidden" name="ExpectedCorrectedAtTicks" value="@(Model.SupervisorCorrectedAtUtc.HasValue ? Model.SupervisorCorrectedAtUtc.Value.Ticks.ToString() : string.Empty)" />
                <p>Cancelling restores the entry and its previous local call disposition. Entries invalidated together will be restored together. Nothing will be sent automatically to Walgreens.</p>
                if (ViewBag.HasInvalidationSnapshot != true)
                {
                    <p>This older invalidation has no saved previous status. Choose the restored status below. Its local correction will be removed so the original BrightPattern disposition applies.</p>
                    <label>
                        <span>Restored status</span>
                        <select name="RestoreStatus" required>
                            <option value="">Choose a status</option>
                            @if (isSupervisorClinicSubmission)
                            {
                                if (ViewBag.HasWalgreensSubmissionEvidence == true)
                                {
                                    <option value="Completed">Already submitted to Walgreens</option>
                                }
                                else
                                {
                                    <option value="Submitted">Awaiting review</option>
                                    <option value="ReviewCompleted">Review completed (does not mark it sent to Walgreens)</option>
                                }
                            }
                            else
                            {
                                <option value="Pending">Pending</option>
                                <option value="Submitted">Submitted</option>
                            }
                        </select>
                    </label>
                }
                <label>
                    <span>Reason for cancelling invalidation</span>
                    <textarea name="Reason" maxlength="500" required placeholder="Explain why this invalidation should be cancelled."></textarea>
                </label>
                <button type="submit" class="agent-correction-submit">&#8617;&#65039; Cancel Invalidation</button>
            }
            </div>
        }
    </section>
}
else if (isSupervisorCorrectableEntry && !isReadOnly)
{
    <section id="agentCorrectionPanel"
             class="agent-correction-panel agent-correction-panel-collapsible"
             aria-labelledby="correctionHeading"
             hidden>
        <h2 id="correctionHeading">Correct an erroneous @correctionEntryLabel</h2>
        <p>Invalidating preserves this entry for audit, excludes it from Walgreens reports, and applies a Walgreens-local call disposition correction.</p>
        @using (Html.BeginForm("Correct", "WalgreensSubmissions", FormMethod.Post, new
        {
            @class = "agent-correction-form",
            data_agent_correction_form = "true",
            data_equivalent_send_info_id = hasEquivalentSendInfo && !equivalentSendInfoIsInvalidated
                ? Model.SupervisorEquivalentSendInfoId.ToString()
                : null,
            data_correction_entry_label = correctionEntryLabel
        }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="EntryType" value="@Model.SupervisorEntryType" />
            <input type="hidden" name="Id" value="@Model.SupervisorEntryId" />
            <input type="hidden" name="InvalidateEquivalentSendInfo" value="false" data-invalidate-equivalent-send-info />
            <label>
                <span>Corrected disposition</span>
                <select name="Disposition" required>
                    <option value="">Choose a disposition</option>
                    @foreach (var disposition in correctionDispositionOptions)
                    {
                        <option value="@disposition">@WalgreensOutcomeDisplay.Name(disposition)</option>
                    }
                </select>
            </label>
            <label>
                <span>Correction reason</span>
                <textarea name="Reason" maxlength="500" required placeholder="Explain why this is not a valid @(correctionEntryLabel)."></textarea>
            </label>
            <button type="submit" class="agent-correction-submit">&#9940; Confirm Invalidation</button>
        }
    </section>
}

<div class="agent-workspace @(importedPhoneOptions.Count > 0 ? "has-imported-contacts" : null)">
    <div class="agent-script-layout @(importedPhoneOptions.Count > 0 ? "has-imported-contacts" : null)">
        @Html.Partial("_WalgreensCallScript", Model.CallScript)

        @if (importedPhoneOptions.Count > 0)
        {
            <aside class="agent-imported-contacts" aria-labelledby="importedContactsHeading">
                <div class="agent-imported-contacts-heading">
                    <span>Call contacts</span>
                    <h2 id="importedContactsHeading">Phone numbers</h2>
                </div>
                @if (!string.IsNullOrWhiteSpace(mainPhoneDigits))
                {
                    <article class="agent-contact-phone-card is-dialed">
                        <span class="agent-contact-phone-kind">Dialed</span>
                        <strong>@formatPhone(Model.PhoneNumber)</strong>
                        <p>@(string.IsNullOrWhiteSpace((Model.FirstName + " " + Model.LastName).Trim()) ? "Main contact" : (Model.FirstName + " " + Model.LastName).Trim())</p>
                    </article>
                }
                @foreach (var importedOption in importedPhoneOptions)
                {
                    var importedContact = importedOption.Item1;
                    var importedPhone = importedOption.Item2;
                    var importedName = ((importedContact.FirstName ?? string.Empty) + " " + (importedContact.LastName ?? string.Empty)).Trim();
                    var importedDigits = normalizePhone(importedPhone.NormalizedPhone ?? importedPhone.PhoneNumber);
                    <article class="agent-contact-phone-card"
                             data-imported-contact-card
                             data-phone="@importedDigits"
                             data-phone-formatted="@formatPhone(importedPhone.PhoneNumber)"
                             data-phone-type="@importedPhone.PhoneType"
                             data-first-name="@importedContact.FirstName"
                             data-last-name="@importedContact.LastName"
                             data-job-title="@importedContact.JobTitle"
                             data-email="@importedContact.Email">
                        <span class="agent-contact-phone-kind">Client-provided @importedPhone.PhoneType</span>
                        <strong>@formatPhone(importedPhone.PhoneNumber)</strong>
                        <p>@(string.IsNullOrWhiteSpace(importedName) ? "Client-provided contact" : importedName)</p>
                        <div class="agent-phone-split-button">
                            <button type="button" class="agent-phone-copy" data-imported-phone-copy>&#128203; Copy phone</button>
                            <button type="button" class="agent-phone-menu-toggle" data-imported-phone-menu-toggle aria-label="More phone actions" title="More phone actions" aria-haspopup="true" aria-expanded="false">&#9662;</button>
                            <div class="agent-phone-menu" data-imported-phone-menu role="menu" hidden>
                                <button type="button" role="menuitem" data-imported-phone-action="copy">Copy only</button>
                                <button type="button" role="menuitem" data-imported-phone-action="fill">Copy + fill contact info</button>
                                <button type="button" role="menuitem" data-imported-phone-action="notes">Copy + add to Notes</button>
                            </div>
                        </div>
                    </article>
                }
                <p class="agent-imported-contacts-help">Changes to contact fields or Notes are not saved until you save the form.</p>
            </aside>
        }
    </div>

    @using (Html.BeginForm("Agent", "Home", FormMethod.Post, new
    {
        @class = "agent-intake-form",
        data_read_only = isReadOnly ? "true" : null,
        data_allow_typed_company = ViewBag.AllowTypedCompany == true ? "true" : "false",
        data_more_info_outcome_url = !isReadOnly ? Url.Action("ScriptOutcome", "Home") : null,
        data_company_lookup_url = !isReadOnly ? Url.Action("CompanyLookup", "Home") : null,
        data_company_choices_url = !isReadOnly ? Url.Action("CompanyChoices", "Home") : null,
        data_draft_save_url = !isReadOnly && supportsDraftSave ? Url.Action("SaveDraft", "Home") : null
    }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CallId)
        @Html.HiddenFor(m => m.AgentId)
        @Html.HiddenFor(m => m.AgentName)
        @Html.HiddenFor(m => m.Ani)
        @Html.HiddenFor(m => m.RawAni)
        @Html.HiddenFor(m => m.Dnis)
        @Html.HiddenFor(m => m.GlobalId)
        @Html.HiddenFor(m => m.BpSessionId)
        @Html.HiddenFor(m => m.BpOrigin)
        @Html.HiddenFor(m => m.PaydayPerxLeadId)
        @Html.HiddenFor(m => m.ReworkItemId)
        @Html.HiddenFor(m => m.SendInfoWorkItemId)
        @Html.HiddenFor(m => m.SendInfoAttemptId)
        @Html.HiddenFor(m => m.CanonicalCompanyLeadId)
        @Html.HiddenFor(m => m.PaydayPerxLeadListName)
        @Html.HiddenFor(m => m.PaydayPerxLeadWebAddress)
        @Html.HiddenFor(m => m.PaydayPerxLeadSicDescription)
        @Html.HiddenFor(m => m.PaydayPerxLeadEmployeeCount)
        @Html.HiddenFor(m => m.SupervisorEntryType)
        @Html.HiddenFor(m => m.SupervisorEntryId)
        @Html.HiddenFor(m => m.SavedRecordId)
        @Html.Hidden("ScriptOpenedAtUtc", Model.ScriptOpenedAtUtc.HasValue ? Model.ScriptOpenedAtUtc.Value.ToString("o") : string.Empty)
        @Html.Hidden("CallStartedAtUtc", Model.CallStartedAtUtc.HasValue ? Model.CallStartedAtUtc.Value.ToString("o") : string.Empty)
        @Html.ValidationSummary(false, "", new { @class = "validation-summary" })

        <section class="agent-call-context" aria-label="Call and lead context" id="contactHeading">
            @if (Model.PaydayPerxLeadId.HasValue)
            {
                <div>
                    <span>Lead ID</span>
                    <code>@Model.PaydayPerxLeadId</code>
                </div>
            }
            @if (hasDnis)
            {
                <div>
                    <span>DNIS</span>
                    <strong>@formattedDnis</strong>
                </div>
            }
            @if (hasAgentId)
            {
                <div>
                    <span>Agent</span>
                    <strong title="@Model.AgentId">@(!string.IsNullOrWhiteSpace(Model.AgentName) ? Model.AgentName : Model.AgentId)</strong>
                </div>
            }
            @if (hasCallId)
            {
                <div>
                    <span>Call ID</span>
                    <code>@Model.CallId</code>
                </div>
            }
            @if (hasLeadContext && !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadListName))
            {
                <div>
                    <span>List</span>
                    <strong>@Model.PaydayPerxLeadListName</strong>
                </div>
            }
            @if (hasLeadContext && !string.IsNullOrWhiteSpace(Model.PaydayPerxLeadSicDescription))
            {
                <div>
                    <span>SIC</span>
                    <strong>@Model.PaydayPerxLeadSicDescription</strong>
